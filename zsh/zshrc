# ~/.zshrc —— 由本仓库的 zsh/zshrc 部署（install.sh 会先备份原文件为 .bak.<时间戳>）
# 依赖：oh-my-zsh（默认走清华镜像克隆）+ 两个自定义插件
#   zsh-autosuggestions      历史命令自动建议
#   zsh-syntax-highlighting  命令行语法高亮（必须放在插件列表最后）
# 详见 zsh/README.md

# oh-my-zsh 安装目录
export ZSH="${HOME}/.oh-my-zsh"

# 主题（oh-my-zsh 自带主题都在 $ZSH/themes/，换个名字即可，如 agnoster / af-magic）
ZSH_THEME="robbyrussell"

# 自动更新：默认每 13 天提醒一次；想彻底关掉就把下面这行取消注释
# zstyle ':omz:update' mode disabled

# 插件列表
#   自带插件   → $ZSH/plugins/
#   自定义插件 → $ZSH/custom/plugins/（由 install.sh 用 git clone 装好）
# 注意：zsh-syntax-highlighting 依赖其它插件已加载，必须排在最后
plugins=(git gitfast z sudo extract colored-man-pages command-not-found history-substring-search copypath copyfile zsh-autosuggestions zsh-syntax-highlighting)

source "${ZSH}/oh-my-zsh.sh"

# ---- history-substring-search：↑/↓ 按已输入的前缀搜索历史 ----
# 注意：这些绑定必须写在 source oh-my-zsh.sh 之后，否则会被覆盖
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

# ---- 其它自己加的配置写在下面 ----
